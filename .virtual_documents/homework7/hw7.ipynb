# List operations do not apply to the entries themselves. Meanwhile, operations on or involving arrays do apply to their entries.





def extract_second_elements(arr):
    """
    This function takes a 2D numpy array and returns a list of 
    the second element from each row.
    """

    second_element = arr[:, 1] # Extract the second element from each row
    
    return second_element.tolist() 

arr1 = np.array([[3, 4, 5], [5, 12, 13], [5, 24, 25]])
result = extract_second_elements(arr1)
print(result)





