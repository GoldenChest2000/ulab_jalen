





import numpy as np





my_list = [10, 20, 30, 40, 50]
my_arr = np.array([10, 20, 30, 40, 50])





operation1 = 4 * my_list
operation2 = 4 * my_arr

print(operation1)
print(operation2)

# For the list it prints it four times, while each entry in the array is multiplied by four





result1 = my_list + my_list
result2 = my_arr + my_arr
print(result1)
print(result2)

# List was printed twice, for array each entry is summed (i.e. entry #1 + entry #1, entry #2 + entry #2, and so on and so forth)





# result3 = my_list - my_list
result4 = my_arr - my_arr
print(result4)

# Subtraction is unsupported for lists, for array each entry is subtracted in the same configuration they were added earlier





# result5 = my_list * my_list
result6 = my_arr * my_arr
result7 = my_list * my_arr
print(result6)
print(result7)

# Once again this operation is impossible with lists, for array * array and list * array the entries are multiplied by each other





# result8 = my_list / my_list
result9 = my_arr / my_arr
result10 = my_list / my_arr
print(result9)
print(result10)

# Once again this operation is impossible with lists, for array / array and list / array the entries are divided by each other in the same way they are added and subtracted





# List operations do not apply to the entries themselves. Meanwhile, operations on or involving arrays do apply to their entries.





def extract_second_elements(arr):
    """
    This function takes a 2D numpy array and returns a list of 
    the second element from each row.
    
    Parameters:
    arr (numpy.ndarray): A two-dimensional array.
    
    Returns:
    list: A list containing the second element from each row.
    """
    # Ensure that the input array has at least two columns
    if arr.shape[1] < 2:
        raise ValueError("Each row must have at least two elements.")
    
    # Extract the second element from each row
    second_elements = arr[:, 1]
    
    return second_elements.tolist()







