import numpy as np

def filter_even_numbers(arr): # Made a function because I got lazy and couldn't figure out how to change the original code to accomodate more cases
    """
    This function takes a numpy array and returns a new array containing only the even numbers.
    """
    filter_arr = [] # Empty list to store True/False values

    for element in arr: # Iterate over each element in the input array
        if element % 2 == 0: # Iterate over each element in the input array
            filter_arr.append(True)
        else:
            filter_arr.append(False)

    return arr[filter_arr] # Use the filter to create a new array with only the even numbers
    
print(filter_even_numbers(arr_VI), filter_even_numbers(arr_VII))

