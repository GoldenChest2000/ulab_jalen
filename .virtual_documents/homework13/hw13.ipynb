import pandas as pd





url = "https://covid.ourworldindata.org/data/owid-covid-data.csv"





df = pd.read_csv(url) # This cell won't run I don't know why, so noth





df_country = df[df["location"] == "United States"]








df_country = df_country[["date", "total_cases"]]
df_country = df_country.dropna()
df_country["days since start"] = range(len(df_country))





print(df_country.head()) # I have no idea why there is no total case data, but if there was, it would show here





from scipy.optimize import curve_fit





def exponential_growth(t, C_0, r):
    return C_0 * np.exp(r * t)





days = df_country["days since start"].iloc[:30].values
cases = df_country["total_cases"].iloc[:30].values

print("Days:", days[:5])  # First 5 values
print("Cases:", cases[:5])  # First 5 values





popt, pcov = curve_fit(exponential_growth, days, cases, p0=[1, 0.1])





C0_fit, r_fit = popt





print(f"Estimated Initial Cases (C_0): {C_0_fit:.4f}")
print(f"Estimated Growth Rate (r): {r_fit:.4f}")





