file_path = 'exoplanet_data.csv'
df = pd.read_csv(file_path)

df_cleaned = df.dropna(subset=['pl_name', 'pl_rade', 'pl_bmasse', 'pl_eqt'])

df_cleaned['Age (Gyr)'] = 3.5

output_file_path = 'cleaned_exoplanet_data.csv'
