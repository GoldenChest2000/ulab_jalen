import pandas as pd





file_path = "exoplanet_data.csv"
exoplanet_df = pd.read_csv(file_path)





print(exoplanet_df.head())





print(exoplanet_df.columns)





planet_names = exoplanet_df["pl_name"]
planet_names.head()





num_planets = exoplanet_df["pl_name"].nunique()
print(num_planets)





planet_data = exoplanet_df[['pl_name', 'pl_rade', 'pl_bmasse', 'pl_eqt']]





print(planet_data)





import matplotlib.pyplot as plt

data = planet_data.dropna(subset=['pl_rade', 'pl_eqt'])

plt.figure(figsize=(8, 6))
plt.scatter(data['pl_rade'], data['pl_eqt'], color='b', label="Exoplanets")

plt.xlabel("Planet Radius (Earth Radii)")
plt.ylabel("Equilibrium Temperature (K)")
plt.title("Exoplanet Earth Radius vs. Equilibrium Temperature")
plt.legend()
plt.grid(True)

plt.show()






# There appears to be a positive trend, the larger the radii, the higher the equolibrium temperature.





coldest_planet = planet_data.loc[planet_data['pl_eqt'].idxmin(), ['pl_name', 'pl_eqt']]
print(coldest_planet)





coldest_planet_data = planet_data.iloc[[planet_data['pl_eqt'].idxmin()]]





num_columns = coldest_planet_data.shape[1]
